# Global Réno — réécriture SPA pour Apache (Hostinger)
# Sans ce fichier, toute URL ouverte directement (ex: /services, /contact,
# /realisations, /blog) renvoie une 404 "This Page Does Not Exist" car le
# serveur cherche un fichier/dossier physique qui n'existe pas : seul React
# Router sait gérer ces routes, et seul index.html charge React Router.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Ne pas réécrire si le fichier ou le dossier demandé existe réellement
  # (images, CSS, JS, uploads, sitemap.xml, robots.txt, etc.)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Pages prérendues (GEO) : /services → services.html, etc.
  # Les robots IA qui ne lisent pas le JavaScript reçoivent ainsi le vrai contenu.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^.]+?)/?$ $1.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Toutes les autres requêtes (blog, admin…) sont envoyées vers la coquille
  # SPA, qui charge React Router pour afficher la bonne page.
  RewriteRule ^ spa.html [L]
</IfModule>

# Évite le double indexage (avec/sans slash final) et les soucis de cache
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Page d'erreur 404 propre si jamais une route n'existe vraiment pas
ErrorDocument 404 /spa.html

# En-têtes de sécurité HTTP standards (absents par défaut sur le site)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

# Blocage explicite des fichiers sensibles (en plus de la protection par défaut)
<FilesMatch "^\.(env|git)">
  Require all denied
</FilesMatch>
