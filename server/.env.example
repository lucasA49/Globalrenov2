PORT=5001
NODE_ENV=production
JWT_SECRET=remplacer_par_une_cle_aleatoire_longue_min_32_chars
JWT_EXPIRES_IN=7d
SITE_URL=https://globalreno-renovation.fr
CLIENT_URL=https://globalreno-renovation.fr
API_URL=https://globalreno-renovation.fr
ADMIN_EMAIL=admin@globalreno.fr
ADMIN_PASSWORD=MotDePasseSecurise123!

# --- Base SQLite : chemin du fichier (conseillé en prod HORS du dossier de l'app,
# ex. /home/<utilisateur>/data/globalreno.db). Vide = server/database.db
DATABASE_PATH=

# --- Optionnel : base Turso à la place du fichier (hébergeur sans disque persistant)
# turso db show globalreno --url   /   turso db tokens create globalreno
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Images Cloudinary (conseillé en prod : les uploads locaux peuvent être effacés au redéploiement)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
